# Per-client credentials. Copy this file to clients/example-brand/.env and
# fill in real values. Never commit the real .env file — it's already
# excluded via the root .gitignore.

# Klaviyo private API key for this client (klaviyo_client.py reads this if
# the Master Sheet's "ESP Private API Key" column is empty for this client).
KLAVIYO_API_KEY=

# Omnisend API key for this client (same fallback pattern).
OMNISEND_API_KEY=

# Asana personal access token + the project ID review tasks get created in.
ASANA_ACCESS_TOKEN=
ASANA_PROJECT_ID=

# Optional — if this client has its own dedicated Google Sheet (rather than
# a shared Master Sheet row), put its Sheet ID here. See shared/brand_config.py.
BRAND_CONFIG_SHEET_ID=
