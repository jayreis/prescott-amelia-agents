# Repo-root config — non-client-specific. Copy this file to .env and fill in
# your own values (or export these as real environment variables — either
# works, this repo doesn't auto-load .env files, see README.md).

# The Google Sheet ID of your Master Email Client Reporting Sheet.
# Find it in the sheet's URL: docs.google.com/spreadsheets/d/THIS_PART/edit
MASTER_SHEET_ID=

# Path to your Google OAuth "Desktop app" client secrets JSON (see README.md
# "Google Sheets setup"). Defaults to config/credentials.json if unset.
GOOGLE_CLIENT_SECRETS=config/credentials.json

# Where the OAuth token gets cached after the first browser login. Defaults
# to ~/.config/prescott-amelia/token.json if unset.
GOOGLE_TOKEN_PATH=

# Your Asana user GID — new review tasks get assigned to this user.
# Find yours by visiting https://app.asana.com/api/1.0/users/me while
# logged in (or via the Asana API explorer).
ASANA_DEFAULT_ASSIGNEE=
